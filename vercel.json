{
  "version": 2,
  "name": "ai-scratch",
  "builds": [
    {
      "src": "/content/*",
      "use": "@vercel/static"
    },
    {
      "src": "/content/*/*",
      "use": "@vercel/static"
    },
    {
      "src": "/api/*.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/content/index.html"
    },
    {
      "src": "/api/([^.]+)",
      "dest": "/api/$1.mjs"
    },
    {
      "src": "/api/([^.]+)/([^.]+)",
      "dest": "/api/$1/$2.mjs"
    },
    {
      "src": "/(.+)",
      "dest": "/content/$1"
    },
    {
      "src": "/(.+)/(.+)",
      "dest": "/content/$1/$2"
    }
  ]
}
