{
  "version": 2,
  "name": "ai-scratch",
  "builds": [
    {
      "src": "/content/*",
      "use": "@vercel/static"
    },
    {
      "src": "/content/*/*",
      "use": "@vercel/static"
    },
    {
      "src": "/api/*.mjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/content/index.html"
    },
    {
      "src": "/api/([^.]+)",
      "dest": "/api/$1.mjs"
    },
    {
      "src": "/api/([^.]+)/([^.]+)",
      "dest": "/api/$1/$2.mjs"
    },
    {
      "src": "/([^.]+)\\.(html|css|js|txt|json)",
      "dest": "/content/$1.$2"
    },
    {
      "src": "/([^.]+)\\.(png|jpg|svg|gif)",
      "dest": "/images/$1.$2"
    },
    {
      "src": "/([^.]+)\\.(zip|type|sb3|pmp|dbp)",
      "dest": "/archives/$1.$2"
    }
  ]
}
